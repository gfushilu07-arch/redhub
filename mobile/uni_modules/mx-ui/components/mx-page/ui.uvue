<template>
	<mx-confirm ref="confirmRef"></mx-confirm>
	<mx-confirm ref="tipsRef"></mx-confirm>
	<mx-toast ref="toastRef"></mx-toast>
</template>

<script setup lang="ts">
import { ref } from "vue";
import type { MxConfirmAction, MxConfirmOptions, MxToastOptions } from "../../types";
import { createUi, type UiInstance } from "../../hooks";
import { t } from "@/.mx";

defineOptions({
	name: "mx-page-ui"
});

// 确认弹窗实例
const confirmRef = ref<MxConfirmComponentPublicInstance | null>(null);

// 提示弹窗实例
const tipsRef = ref<MxConfirmComponentPublicInstance | null>(null);

// 提示弹窗实例
const toastRef = ref<MxToastComponentPublicInstance | null>(null);

/**
 * 显示确认弹窗
 * @param options MxConfirmOptions 弹窗配置项
 */
function showConfirm(options: MxConfirmOptions) {
	if (confirmRef.value != null) {
		confirmRef.value!.open(options);
	}
}

/**
 * 显示提示弹窗
 * @param message 提示消息
 * @param callback 回调函数
 */
function showTips(message: string, callback: (action: MxConfirmAction) => void) {
	if (tipsRef.value != null) {
		tipsRef.value!.open({
			title: t("提示"),
			message,
			callback,
			showCancel: false
		} as MxConfirmOptions);
	}
}

/**
 * 显示提示弹窗
 * @param options MxToastOptions 弹窗配置项
 */
function showToast(options: MxToastOptions) {
	if (toastRef.value != null) {
		toastRef.value!.open(options);
	}
}

// 注册当前页面的 UiInstance 实例
createUi({
	showConfirm,
	showTips,
	showToast
} as UiInstance);
</script>
