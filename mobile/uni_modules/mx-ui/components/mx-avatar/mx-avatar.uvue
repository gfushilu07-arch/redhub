<template>
	<mx-image
		:src="src"
		:height="size"
		:width="size"
		:pt="{
			className: parseClass([
				'mx-avatar',
				{
					'!rounded-full': rounded
				},
				pt.className
			])
		}"
	>
		<template #loading>
			<mx-icon
				:name="pt.icon?.name ?? 'user-smile-fill'"
				:size="pt.icon?.size ?? 20"
				:pt="{
					className: parseClass([
						[isDark, '!text-surface-50', '!text-surface-400'],
						pt.icon?.className
					])
				}"
			></mx-icon>
		</template>

		<slot></slot>
	</mx-image>
</template>

<script setup lang="ts">
import { isDark, parseClass, parsePt } from "@/.mx";
import { computed } from "vue";
import type { MxIconProps } from "../mx-icon/props";

defineOptions({
	name: "mx-avatar"
});

const props = defineProps({
	pt: {
		type: Object,
		default: () => ({})
	},
	src: {
		type: String,
		default: ""
	},
	size: {
		type: Number,
		default: 40
	},
	rounded: {
		type: Boolean,
		default: false
	}
});

type PassThrough = {
	className?: string;
	icon?: MxIconProps;
};

const pt = computed(() => parsePt<PassThrough>(props.pt));
</script>
