<template>
	<view
		class="mx-skeleton"
		:class="[
			{
				'is-loading': loading,
				'is-dark': isDark
			},
			`mx-skeleton--${props.type}`,
			`${loading ? `${pt.loading?.className}` : ''}`,
			pt.className
		]"
		ref="skeletonRef"
	>
		<template v-if="loading">
			<mx-icon
				name="image-line"
				:pt="{
					className: '!text-surface-400'
				}"
				:size="20"
				v-if="type == 'image'"
			></mx-icon>
		</template>

		<template v-else>
			<slot></slot>
		</template>
	</view>
</template>

<script setup lang="ts">
import { computed, onMounted, ref, watch, type PropType } from "vue";
import type { PassThroughProps } from "../../types";
import { AnimationEngine, createAnimation, isDark, parsePt } from "@/.mx";

defineOptions({
	name: "mx-skeleton"
});

const props = defineProps({
	pt: {
		type: Object,
		default: () => ({})
	},
	loading: {
		type: Boolean,
		default: true
	},
	type: {
		type: String as PropType<"text" | "image" | "circle" | "button">,
		default: "text"
	}
});

type PassThrough = {
	className?: string;
	loading?: PassThroughProps;
};

const pt = computed(() => parsePt<PassThrough>(props.pt));

// 组件引用
const skeletonRef = ref<UniElement | null>(null);

// 动画实例
let animation: AnimationEngine | null = null;

// 开始动画
function start() {
	if (!props.loading) return;

	animation = createAnimation(skeletonRef.value, {
		duration: 2000,
		loop: -1,
		alternate: true
	})
		.opacity("0.3", "1")
		.play();
}

// 停止动画
function stop() {
	if (animation != null) {
		animation!.stop();
		animation!.reset();
	}
}

onMounted(() => {
	watch(
		computed(() => props.loading),
		(val: boolean) => {
			if (val) {
				start();
			} else {
				stop();
			}
		},
		{
			immediate: true
		}
	);
});
</script>

<style lang="scss" scoped>
.mx-skeleton {
	&.is-loading {
		@apply bg-surface-100 rounded-md;

		&.is-dark {
			@apply bg-surface-600;
		}

		&.mx-skeleton--text {
			height: 16px;
			width: 150px;
			border-radius: 4px;
		}

		&.mx-skeleton--image {
			@apply flex flex-row items-center justify-center;
			width: 60px;
			height: 60px;
			border-radius: 8px;
		}

		&.mx-skeleton--circle {
			@apply rounded-full;
			width: 60px;
			height: 60px;
		}

		&.mx-skeleton--button {
			@apply rounded-lg;
			height: 32px;
			width: 88px;
		}
	}
}
</style>
