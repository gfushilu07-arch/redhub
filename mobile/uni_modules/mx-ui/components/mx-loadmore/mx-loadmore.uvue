<template>
	<view class="mx-loadmore-wrapper">
		<view class="mx-loadmore">
			<mx-loading
				:pt="{
					className: `mr-2 ${pt.icon?.className}`
				}"
				v-if="loading"
			></mx-loading>

			<mx-text
				:pt="{
					className: pt.text?.className
				}"
				>{{ message }}</mx-text
			>
		</view>

		<mx-safe-area type="bottom" v-if="safeAreaBottom"></mx-safe-area>
	</view>
</template>

<script lang="ts" setup>
import { computed } from "vue";
import { parsePt, t } from "@/.mx";
import type { PassThroughProps } from "../../types";

defineOptions({
	name: "mx-loadmore"
});

const props = defineProps({
	pt: {
		type: Object,
		default: () => ({})
	},
	// 是否加载中
	loading: {
		type: Boolean,
		default: false
	},
	// 加载中显示内容
	loadingText: {
		type: String,
		default: () => t("加载中")
	},
	// 是否加载完成
	finish: {
		type: Boolean,
		default: false
	},
	// 加载完成显示内容
	finishText: {
		type: String,
		default: () => t("没有更多了")
	},
	// 是否显示底部安全区
	safeAreaBottom: {
		type: Boolean,
		default: false
	}
});

type PassThrough = {
	className?: string;
	icon?: PassThroughProps;
	text?: PassThroughProps;
};

const pt = computed(() => parsePt<PassThrough>(props.pt));

// 消息内容
const message = computed(() => {
	if (props.finish) {
		return props.finishText;
	}

	if (props.loading) {
		return props.loadingText;
	}

	return "";
});
</script>

<style lang="scss" scoped>
.mx-loadmore-wrapper {
	@apply flex flex-col items-center justify-center py-2;
}

.mx-loadmore {
	@apply flex flex-row items-center justify-center;
}
</style>
