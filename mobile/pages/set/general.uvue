<template>
	<mx-page>
		<view class="p-3">
			<mx-list>
				<mx-list-item :label="t('深色模式')">
					<mx-switch :model-value="isDark" @change="onThemeChange"></mx-switch>
				</mx-list-item>

				<mx-list-item :label="t('多语言')" arrow hoverable @tap="setLocale"> </mx-list-item>

				<mx-list-item :label="t('字体大小')" arrow hoverable @tap="setSize"> </mx-list-item>
			</mx-list>
		</view>

		<!-- 语言设置 -->
		<locale-set :ref="refs.set('localeSet')"></locale-set>

		<!-- 字体大小设置 -->
		<size-set :ref="refs.set('sizeSet')"></size-set>
	</mx-page>
</template>

<script setup lang="ts">
import { isDark, toggleTheme, useRefs, t } from "@/.mx";
import LocaleSet from "@/components/locale-set.uvue";
import SizeSet from "@/components/size-set.uvue";

const refs = useRefs();

function onThemeChange() {
	toggleTheme();
}

function setLocale() {
	refs.open("localeSet");
}

function setSize() {
	refs.open("sizeSet");
}
</script>
