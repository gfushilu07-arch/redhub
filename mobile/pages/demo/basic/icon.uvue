<template>
	<mx-page>
		<view class="p-3">
			<demo-item :label="t('设置颜色')">
				<view class="flex flex-row">
					<mx-icon name="heart-fill" color="primary" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="success" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="error" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="warn" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="info" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="#428bca" class="mr-2"></mx-icon>
					<mx-icon name="heart-fill" color="purple"></mx-icon>
				</view>
			</demo-item>

			<demo-item :label="t('设置大小')">
				<view class="flex flex-row">
					<mx-icon name="heart-fill" class="mr-2" :size="26"></mx-icon>
					<mx-icon name="heart-fill" class="mr-2" :size="22"></mx-icon>
					<mx-icon name="heart-fill" class="mr-2" :size="18"></mx-icon>
					<mx-icon name="heart-fill" class="mr-2" :size="14"></mx-icon>
				</view>
			</demo-item>

			<demo-item>
				<mx-text>{{ t("集成 iconfont 与 remixicon 图标库，展示部分示例") }}</mx-text>
			</demo-item>

			<demo-item :label="t('iconfont')">
				<mx-row :gutter="10">
					<mx-col :span="4" v-for="item in iconfont" :key="item">
						<view
							class="flex flex-col items-center justify-center h-[50px] rounded-lg"
							hover-class="opacity-60"
							:hover-stay-time="250"
							@tap="copy(item)"
						>
							<mx-icon :name="item" :size="16"></mx-icon>
						</view>
					</mx-col>
				</mx-row>
			</demo-item>

			<demo-item :label="t('remixicon')">
				<mx-row :gutter="10">
					<mx-col :span="4" v-for="item in remixicon" :key="item">
						<view
							class="flex flex-col items-center justify-center h-[50px]"
							hover-class="opacity-60"
							:hover-stay-time="250"
							@tap="copy(item)"
						>
							<mx-icon :name="item" :size="16"></mx-icon>
						</view>
					</mx-col>
				</mx-row>
			</demo-item>
		</view>
	</mx-page>
</template>

<script lang="ts" setup>
import { ref } from "vue";
import DemoItem from "../components/item.uvue";
import { forInObject, keys, icons, t } from "@/.mx";
import { useUi } from "@/uni_modules/mx-ui";

const ui = useUi();

const remixicon = ref<string[]>([]);
const iconfont = ref<string[]>([]);

forInObject(icons, (value, key) => {
	if (key == "iconfont") {
		iconfont.value = keys(value).slice(0, 100);
	} else {
		remixicon.value = keys(value).slice(0, 100);
	}
});

function copy(data: string) {
	uni.setClipboardData({
		data,
		showToast: false,
		success() {
			ui.showToast({
				message: t("复制成功")
			});
		}
	});
}
</script>
