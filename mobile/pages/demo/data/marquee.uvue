<template>
	<mx-page>
		<view class="p-3">
			<demo-item :label="t('横向滚动')">
				<mx-marquee
					:list="list"
					direction="horizontal"
					:item-height="100"
					:item-width="180"
					:pt="{
						className: 'h-[100px] rounded-xl'
					}"
				></mx-marquee>
			</demo-item>

			<demo-item :label="t('纵向滚动')">
				<mx-marquee
					ref="marqueeRef"
					:list="list"
					direction="vertical"
					:item-height="130"
					:duration="isSpeed ? 2000 : 5000"
					:pt="{
						className: 'h-[250px] rounded-xl'
					}"
				></mx-marquee>

				<mx-list
					border
					:pt="{
						className: 'mt-5'
					}"
				>
					<mx-list-item :label="t('快一点')">
						<mx-switch v-model="isSpeed"></mx-switch>
					</mx-list-item>

					<mx-list-item :label="t('暂停')">
						<mx-switch v-model="isPause" @change="onPauseChange"></mx-switch>
					</mx-list-item>
				</mx-list>
			</demo-item>
		</view>
	</mx-page>
</template>

<script lang="ts" setup>
import DemoItem from "../components/item.uvue";
import { t } from "@/.mx";
import { ref } from "vue";

const marqueeRef = ref<MxMarqueeComponentPublicInstance | null>(null);

const list = ref<string[]>([
	"https://unix.redhub.example/images/demo/bg1.png",
	"https://unix.redhub.example/images/demo/bg2.png",
	"https://unix.redhub.example/images/demo/bg3.png"
]);

const isSpeed = ref(false);
const isPause = ref(false);

function onPauseChange(value: boolean) {
	if (value) {
		marqueeRef.value!.pause();
	} else {
		marqueeRef.value!.play();
	}
}
</script>
