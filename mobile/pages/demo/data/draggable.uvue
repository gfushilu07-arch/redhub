<template>
	<mx-page>
		<view class="p-3">
			<demo-item>
				<mx-text color="info">
					{{ t("长按项即可拖动排序") }}
				</mx-text>
			</demo-item>

			<demo-item :label="t('单列排序')">
				<mx-draggable v-model="list">
					<template #item="{ item, index }">
						<view
							class="flex flex-row items-center p-3 bg-surface-100 rounded-lg mb-2 dark:!bg-surface-700"
							:class="{
								'opacity-50': item['disabled']
							}"
						>
							<mx-text>{{ (item as UTSJSONObject).label }}</mx-text>
						</view>
					</template>
				</mx-draggable>
			</demo-item>

			<demo-item :label="t('不需要长按')">
				<mx-draggable v-model="list5" :long-press="false">
					<template #item="{ item }">
						<view
							class="flex flex-row items-center p-3 bg-surface-100 rounded-lg mb-2 dark:!bg-surface-700"
						>
							<mx-text>{{ (item as UTSJSONObject).label }}</mx-text>
						</view>
					</template>
				</mx-draggable>
			</demo-item>

			<demo-item :label="t('结合列表使用')">
				<mx-list border>
					<mx-draggable v-model="list2">
						<template #item="{ item, index, dragging, dragIndex }">
							<mx-list-item
								icon="chat-thread-line"
								:label="(item as UTSJSONObject).label"
								arrow
								:pt="{
									inner: {
										className: parseClass([
											[
												dragging && dragIndex == index,
												isDark ? '!bg-surface-700' : '!bg-surface-100'
											]
										])
									}
								}"
							></mx-list-item>
						</template>
					</mx-draggable>
				</mx-list>
			</demo-item>

			<demo-item :label="t('多列排序')">
				<mx-draggable v-model="list3" :columns="4">
					<template #item="{ item, index }">
						<view
							class="flex flex-row items-center justify-center p-3 bg-surface-100 rounded-lg m-1 dark:!bg-surface-700"
							:class="{
								'opacity-50': item['disabled']
							}"
						>
							<mx-text>{{ (item as UTSJSONObject).label }}</mx-text>
						</view>
					</template>
				</mx-draggable>
			</demo-item>

			<demo-item :label="t('结合图片使用')">
				<mx-draggable v-model="list4" :columns="4">
					<template #item="{ item, index }">
						<view class="p-[2px]">
							<mx-image
								:src="(item as UTSJSONObject).url"
								mode="widthFix"
								:pt="{
									className: '!w-full'
								}"
								preview
							></mx-image>
						</view>
					</template>
				</mx-draggable>
			</demo-item>
		</view>
	</mx-page>
</template>

