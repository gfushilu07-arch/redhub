													`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
												]
											])
										}"
									></mx-checkbox>
								</mx-col>
							</mx-row>
						</mx-form-item>

						<mx-form-item label="内存">
							<mx-row :gutter="20">
								<mx-col
									:span="8"
