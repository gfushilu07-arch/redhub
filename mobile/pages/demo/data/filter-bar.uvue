									placeholder="最高价"
									:pt="{
										className: 'flex-1',
										inner: {
											className: 'text-center'
										}
									}"
								></mx-input>
							</view>
						</mx-form-item>

						<mx-form-item label="品牌">
							<mx-row :gutter="20">
								<mx-col
