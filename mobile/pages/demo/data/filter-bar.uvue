												'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
												[isDark, 'bg-surface-800', 'bg-surface-100'],
												[
													searchForm.dis.includes(item.value),
													`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
