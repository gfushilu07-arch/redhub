					></mx-filter-item>

					<!-- 开关 -->
					<mx-filter-item
						label="国补"
						type="switch"
						:value="false"
						@change="onSwitchChange"
					></mx-filter-item>

					<!-- 自定义 -->
					<view
						class="flex flex-row items-center justify-center flex-1"
						@tap="openFilter"
					>
						<mx-text>筛选</mx-text>
						<mx-icon name="filter-line"></mx-icon>
					</view>
				</mx-filter-bar>
			</demo-item>

			<demo-item>
				<mx-text pre-wrap :pt="{ className: 'p-2' }">{{
					JSON.stringify(filterForm, null, 4)
				}}</mx-text>
			</demo-item>

			<demo-item>
				<mx-text pre-wrap :pt="{ className: 'p-2' }">{{
					JSON.stringify(searchForm, null, 4)
				}}</mx-text>
			</demo-item>
		</view>

		<!-- 自定义筛选 -->
		<mx-popup
