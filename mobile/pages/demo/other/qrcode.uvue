<template>
	<mx-page>
		<view class="p-3">
			<demo-item :label="t('自定义')">
				<view class="flex flex-row justify-center py-3">
					<mx-qrcode
						ref="qrcodeRef"
						text="https://redhub.example/"
						:logo="isLogo ? 'https://unix.redhub.example/logo.png' : ''"
						:pd-radius="isPdRadius ? 50 : 0"
						:padding="isPadding ? 10 : 5"
						:foreground="isColor ? '#14b8a6' : '#000000'"
						:pd-color="isColor ? '#0d9488' : '#000000'"
						:mode="mode"
					></mx-qrcode>
				</view>

				<mx-list border class="mt-3">
					<mx-list-item :label="t('添加LOGO')">
						<mx-switch v-model="isLogo"></mx-switch>
					</mx-list-item>

					<mx-list-item :label="t('圆角定位点')">
						<mx-switch v-model="isPdRadius"></mx-switch>
					</mx-list-item>

					<mx-list-item :label="t('内间距')">
						<mx-switch v-model="isPadding"></mx-switch>
					</mx-list-item>

					<mx-list-item :label="t('自定义颜色')">
						<mx-switch v-model="isColor"></mx-switch>
					</mx-list-item>

					<mx-list-item :label="t('导出图片')">
						<mx-button @tap="save">{{ t("预览") }}</mx-button>
					</mx-list-item>

					<view class="p-2">
						<mx-tabs v-model="mode" :list="modeList" show-slider></mx-tabs>
					</view>
				</mx-list>
			</demo-item>
		</view>
	</mx-page>
</template>

<script lang="ts" setup>
import type { MxQrcodeMode, MxTabsItem } from "@/uni_modules/mx-ui";
import DemoItem from "../components/item.uvue";
import { ref } from "vue";
import { t } from "@/.mx";

const isLogo = ref(true);
const isPdRadius = ref(true);
const isPadding = ref(false);
const isColor = ref(false);

const qrcodeRef = ref<MxQrcodeComponentPublicInstance | null>(null);

const mode = ref<MxQrcodeMode>("circular");
const modeList = [
	{
		label: t("矩形"),
		value: "rect"
	},
	{
		label: t("点"),
		value: "circular"
	},
	{
		label: t("线性"),
		value: "line"
	},
	{
		label: t("小方格"),
		value: "rectSmall"
	}
] as MxTabsItem[];

function save() {
	qrcodeRef.value!.toPng().then((url) => {
		uni.previewImage({
			urls: [url]
		});
	});
}
</script>
