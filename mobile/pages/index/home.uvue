						<mx-text :size="15" color="white" :pt="{ className: 'font-bold' }">Mx</mx-text>
					</view>
				<mx-text :size="17" :pt="{ className: 'ml-3 mr-auto font-bold' }">RedHub</mx-text>
				<view class="round-action" :class="{ 'dark-action': isDark }" @tap="toLogin">
					<mx-icon name="user-3-line" :size="16"></mx-icon>
				</view>
			</view>
		</mx-topbar>

		<view class="px-3 pb-28">
