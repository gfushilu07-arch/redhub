			<mx-row :gutter="10">
				<mx-col v-for="item in actions" :key="item.label" :span="6">
					<view class="action-card" :class="{ 'dark-action': isDark }" hover-class="opacity-80" :hover-stay-time="120" @tap="open(item.path)">
						<view class="action-icon">
							<mx-icon :name="item.icon" :size="18" color="#C41E3A"></mx-icon>
						</view>
						<mx-text :size="12" :pt="{ className: 'mt-2 text-center' }">{{ item.label }}</mx-text>
