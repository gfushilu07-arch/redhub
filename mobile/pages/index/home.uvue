<script setup lang="ts">
import { isDark, isMp, router } from "@/.mx";
import { computed } from "vue";
import CustomTabbar from "./components/tabbar.uvue";

type MenuItem = {
	label: string;
	icon: string;
	path: string;
};

const actions = computed<MenuItem[]>(() => [
	{ label: "组织生活", icon: "flag-line", path: "/pages/index/template" },
	{ label: "学习教育", icon: "book-2-line", path: "/pages/index/template" },
	{ label: "事项办理", icon: "file-copy-line", path: "/pages/index/template" },
	{ label: "登录", icon: "login-circle-line", path: "/pages/user/login" }
]);

const notices = computed(() => [
	{ title: "本月主题党日活动报名开始", date: "08-22" },
	{ title: "志愿服务积分兑换通知", date: "08-20" },
	{ title: "党员学习材料已更新", date: "08-18" }
]);

const services = computed<MenuItem[]>(() => [
	{ label: "党费缴纳", icon: "wallet-line", path: "/pages/user/login" },
	{ label: "活动预约", icon: "calendar-line", path: "/pages/index/template" },
	{ label: "进度查询", icon: "history-line", path: "/pages/index/template" },
	{ label: "个人中心", icon: "account-circle-line", path: "/pages/index/my" }
]);

function toLogin() {
	router.to("/pages/user/login");
}

function open(path: string) {
	router.to(path);
}
</script>

